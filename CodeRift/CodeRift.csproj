<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\Audio\sfx\" />
    <Folder Include="Assets\Audio\music\" />
    <Folder Include="Core\" />
    <Folder Include="Core\Battle\" />
    <Folder Include="Core\Questions\" />
    <Folder Include="Core\Transitions\" />
    <Folder Include="Entities\" />
    <Folder Include="Managers\" />
    <Folder Include="Managers\Progress\" />
    <Folder Include="Managers\Questions\" />
    <Folder Include="Utils\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\BattleArenaForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\BattleArenaForm.Designer.cs">
      <DependentUpon>BattleArenaForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\BattleArenaForm.resx">
      <DependentUpon>BattleArenaForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\BattleArenaQuestionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\BattleArenaQuestionForm.Designer.cs">
      <DependentUpon>BattleArenaQuestionForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\BattleArenaQuestionForm.resx">
      <DependentUpon>BattleArenaQuestionForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Utils\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
